{
  "name": "wexample/symfony-remote-dila",
  "description": "The DILA's open data, as symfony-remotes: the verbatim reports of the Assemblée nationale, read into debate points",
  "version": "2.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteDila\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteDila\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-remote": ">=2.4.0",
    "wexample/php-remote": ">=4.0.0",
    "symfony/http-client": ">=7.0",
    "symfony/filesystem": ">=7.0",
    "symfony/process": ">=7.0",
    "ext-dom": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}